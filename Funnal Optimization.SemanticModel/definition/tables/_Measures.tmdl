	measure 'Session to View Drop %' =
			
			VAR TotalSessions = [Total Sessions]
			VAR ViewSessions = [Sessions with Views]
			RETURN
			DIVIDE(TotalSessions - ViewSessions, TotalSessions, 0)
		formatString: #,0%;-#,0%;#,0%
		displayFolder: Funnel Analysis Metrics
		lineageTag: 80a47b1a-a4ed-416e-b935-197cf9945fde

	measure 'View to Cart Drop %' =
			
			VAR ViewSessions = [Sessions with Views]
			VAR CartSessions = [Sessions with Cart]
			RETURN
			DIVIDE(ViewSessions - CartSessions, ViewSessions, 0)
		formatString: 0%;-0%;0%
		displayFolder: Funnel Analysis Metrics
		lineageTag: 29ed72d0-efa9-4079-b350-9233a100c7fa

	measure 'Cart to Checkout Drop %' =
			
			VAR CartSessions = [Sessions with Cart]
			VAR CheckoutSessions = [Sessions with Checkout]
			RETURN
			DIVIDE(CartSessions - CheckoutSessions, CartSessions, 0)
		formatString: #,0%;-#,0%;#,0%
