	measure 'Checkout to Purchase Drop %' =
			
			VAR CheckoutSessions = [Sessions with Checkout]
			VAR Purchases = [Total Purchases]
			RETURN
			DIVIDE(CheckoutSessions - Purchases, CheckoutSessions, 0)
		formatString: 0%;-0%;0%
		displayFolder: Funnel Analysis Metrics
