	measure 'WoW Sessions Growth %' =
			
			VAR CurrentSessions = [WTD Sessions]
			VAR PreviousSessions = [Previous Week Sessions]
			RETURN
			DIVIDE(
			    CurrentSessions - PreviousSessions,
			    PreviousSessions,
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Conversion Metrics
		lineageTag: 7f749823-3e59-4830-b962-abfd9a25c55c

	measure 'MTD Sessions' = ```
			
			VAR MaxDate =
			    MAX ( Calendar[Date] )
			RETURN
			CALCULATE (
			    [Total Sessions],
			    FILTER (
			        ALL ( Calendar[Date] ),
			        Calendar[Date] >= DATE ( YEAR ( MaxDate ), MONTH ( MaxDate ), 1 )
			            && Calendar[Date] <= MaxDate
			    )
			)
			
			
			```
		formatString: 0
		displayFolder: Conversion Metrics
		lineageTag: a393a01a-2d1c-46de-8a87-53fc75aac6c4

	measure 'WTD Sessions' = ```
			
			VAR MaxDate =
			    MAX ( Calendar[Date] )
			VAR WeekStart =
			    MaxDate - WEEKDAY ( MaxDate, 2 ) + 1
			RETURN
			CALCULATE (
			    [Total Sessions],
			    FILTER (
			        ALL ( Calendar[Date] ),
			        Calendar[Date] >= WeekStart
			            && Calendar[Date] <= MaxDate
			    )
			)
			
			```
		formatString: 0
		displayFolder: Conversion Metrics
		lineageTag: a93724a2-5041-4bc6-9f44-da347c6335e6

	measure 'Current Month AOV' = ```
			
			VAR MaxDate =
			    MAX ( Calendar[Date] )
			VAR MonthStart =
			    DATE ( YEAR ( MaxDate ), MONTH ( MaxDate ), 1 )
			RETURN
			CALCULATE (
			    [AOV],
			    FILTER (
			        ALL ( Calendar[Date] ),
			        Calendar[Date] >= MonthStart
			            && Calendar[Date] <= MaxDate
			    )
			)
			
			```
		formatString: "Rs"#,0.###############;-"Rs"#,0.###############;"Rs"#,0.###############
		displayFolder: AOV Optimization Metrics
		lineageTag: d119f28b-506a-4933-a56b-f1722c8e20bd

