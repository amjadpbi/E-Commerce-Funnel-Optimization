	measure 'Abandoned Carts by Device' =
			
			CALCULATE(
			    COUNTROWS('Cart_Abandonment'),
			    ALLEXCEPT('Cart_Abandonment', Sessions[device])
			)
		formatString: 0
		displayFolder: Funnel Analysis Metrics
