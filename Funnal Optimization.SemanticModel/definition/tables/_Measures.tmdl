	measure 'Sessions with Purchase' = ```
			CALCULATE(
			    DISTINCTCOUNT('funnel_events'[session_id]),
			    'funnel_events'[event_type] = "purchase"
			)
			
			```
		formatString: 0
		displayFolder: Funnel Analysis Metrics
		lineageTag: 2235e165-02e3-4337-a2c4-a11ba6275f58

	measure 'Conversion Rate by Category' =
			
			CALCULATE(
			    [Conversion Rate],
			    ALLEXCEPT('funnel_events', 'Funnel_Events'[category])
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Funnel Analysis Metrics
		lineageTag: 19080854-cfde-4e1d-992f-02105fcb57aa

	measure 'Abandoned Value by Category' =
			
			VAR CurrentCategory = SELECTEDVALUE('funnel_events'[category])
			RETURN
			IF(
			    NOT ISBLANK(CurrentCategory),
			    CALCULATE(
			        SUM('cart_abandonment'[cart_value]),
			        FILTER(
			            'Cart_Abandonment',
			            CALCULATE(
			                COUNTROWS('Funnel_Events'),
			                'Funnel_Events'[category] = CurrentCategory,
			                'Funnel_Events'[event_type] = "add_to_cart"
			            ) > 0
			        )
			    ),
			    BLANK()
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Cart Abandonment Metrics
		lineageTag: fd37229b-9a8f-42cb-8f6e-73c564816a4f

	measure 'AOV by Category' =
			
			CALCULATE(
			    DIVIDE(
			        SUM(Transactions[gross_revenue]),
			        COUNTROWS(Transactions),
			        0
			    ),
			    TREATAS(
			        VALUES('Funnel_Events'[session_id]),
			        Transactions[session_id]
			    ),
			    'Funnel_Events'[event_type] = "purchase"
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: AOV Optimization Metrics
		lineageTag: 56279fcf-3226-4655-bb4b-74bd0b5bfb5c

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

