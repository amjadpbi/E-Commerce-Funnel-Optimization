table _Measures
	lineageTag: 68fddc0c-ed0e-43cd-8b31-7f6181821823

	measure 'Total Sessions' = COUNTROWS(Sessions)
		formatString: 0
		displayFolder: Conversion Metrics
		lineageTag: 58d589b5-1526-49db-8ee0-ecc4d74f1b58

	measure 'Total Purchases' = COUNTROWS(Transactions)
		formatString: 0
		displayFolder: Conversion Metrics
		lineageTag: 8ab5ca6b-134a-438c-9cae-f6c7ed811223

	measure 'Conversion Rate' = ```
			DIVIDE(
			    [Total Purchases],
			    [Total Sessions],
			    0
			)
			
			```
		formatString: 0%;-0%;0%
		displayFolder: Conversion Metrics
		lineageTag: 8b541b1c-d4ba-4f89-9486-e938c15dc185

	measure 'Total Revenue' = SUM(transactions[gross_revenue])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Conversion Metrics
		lineageTag: a74bbd01-d455-4ecb-8a73-b91f29a7ba41

	measure AOV = ```
			DIVIDE(
			    [Total Revenue],
			    [Total Purchases],
			    0
			)
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Conversion Metrics
		lineageTag: e4628652-60bd-4f90-86e1-b9793b975648

	measure 'Sessions with Views' = ```
			CALCULATE(
			    DISTINCTCOUNT('funnel_events'[session_id]),
			    'funnel_events'[event_type] = "product_view"
			)
			
			```
		formatString: 0
		displayFolder: Funnel Analysis Metrics
		lineageTag: 12d596db-09ee-4b7f-9de6-fa91b6cb4e1d

	measure 'Sessions with Cart' = ```
			CALCULATE(
			    DISTINCTCOUNT('funnel_events'[session_id]),
			    'funnel_events'[event_type] = "add_to_cart"
			)
			
			```
		formatString: 0
		displayFolder: Funnel Analysis Metrics
		lineageTag: 1ac651af-bbde-487d-915b-54c2da2fc6e2

	measure 'Sessions with Checkout' = ```
			
			CALCULATE(
			    DISTINCTCOUNT('funnel_events'[session_id]),
			    'funnel_events'[event_type] = "checkout_start"
			)
			
			```
		formatString: 0
		displayFolder: Funnel Analysis Metrics
		lineageTag: a33e8c51-e39d-4d3e-aff4-568a97504d06

	measure 'View to Cart %' = ```
			DIVIDE(
			    [Sessions with Cart],
			    [Sessions with Views],
			    0
			)
			
			```
		displayFolder: Funnel Analysis Metrics
		lineageTag: 66e3d181-0369-42ee-a312-776239cc4e29

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cart to Checkout %' =
			DIVIDE(
			    [Sessions with Checkout],
			    [Sessions with Cart],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Funnel Analysis Metrics
		lineageTag: f5a0c383-591f-4b2a-b0fb-80a2a167fc1e

	measure 'Checkout to Purchase %' = ```
			DIVIDE(
			    [Total Purchases],
			    [Sessions with Checkout],
			    0
			)
			
			```
		displayFolder: Funnel Analysis Metrics
		lineageTag: 8d711239-4e38-431f-94d5-1ef61977723a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cart Abandonment Rate' = ```
			
			VAR CartSessions = [Sessions with Cart]
			VAR PurchasedSessions = [Total Purchases]
			RETURN
			DIVIDE(
			    CartSessions - PurchasedSessions,
			    CartSessions,
			    0
			)
			
			```
		formatString: 0%;-0%;0%
		displayFolder: Cart Abandonment Metrics
		lineageTag: a0833bd5-14ad-40f7-a7fc-ee0c158fd743

	measure 'Abandoned Cart Value' = SUM('Cart_Abandonment'[cart_value])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Cart Abandonment Metrics
		lineageTag: a44afc74-311c-486b-a19d-e711a8343e29

	measure 'Lost Revenue Potential' = ```
			
			VAR AbandonedValue = [Abandoned Cart Value]
			VAR AvgConversionRate = [Conversion Rate]
			RETURN
			AbandonedValue * AvgConversionRate
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Cart Abandonment Metrics
		lineageTag: 95e287bf-e826-4cd5-a794-6c9653808210

	measure 'Average Abandonment Value' = ```
			DIVIDE(
			    [Abandoned Cart Value],
			    COUNTROWS('Cart_Abandonment'),
			    0
			)
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Cart Abandonment Metrics
		lineageTag: 31700aa9-1013-497d-a0e1-e5af6c2f4993

	measure 'Bundle AOV' = ```
			CALCULATE(
			    [AOV],
			    Transactions[had_bundle] = "Yes"
			)
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: AOV Optimization Metrics
		lineageTag: f6757beb-58a7-41d0-8418-b261feec607c

	measure 'Single Item AOV' = ```
			CALCULATE(
			    [AOV],
			    Transactions[had_bundle] = "No"
			)
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: AOV Optimization Metrics
		lineageTag: 85da0d07-e1e2-4124-83b3-87d9ecc2282d

	measure 'Bundle Uplift %' = ```
			DIVIDE(
			    [Bundle AOV] - [Single Item AOV],
			    [Single Item AOV],
			    0
			)
			
			```
		formatString: 0%;-0%;0%
		displayFolder: AOV Optimization Metrics
		lineageTag: f8be0cd1-1031-4c33-87cf-3259abaf6ea4

	measure 'Discount Impact on AOV' = ```
			
			VAR WithDiscount = 
			    CALCULATE([AOV], Transactions[discount_amount] > 0)
			VAR NoDiscount = 
			    CALCULATE([AOV], Transactions[discount_amount] = 0)
			RETURN
			WithDiscount - NoDiscount
			
			```
		formatString: "Rs"#,0.###############;-"Rs"#,0.###############;"Rs"#,0.###############
		displayFolder: AOV Optimization Metrics
		lineageTag: 60a3cf16-44f7-490d-b63c-a4bfcacb93b9

		annotation PBI_FormatHint = {"currencyCulture":"en-PK"}

	measure 'MTD Revenue' = TOTALMTD([Total Revenue], transactions[order_date])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Time Intelligence
		lineageTag: 43b0311f-3d28-442f-b1a5-4d5f761de801

	measure 'Previous Month Revenue' = ```
			
			VAR MaxDate =
			    MAX ( Calendar[Date] )
			VAR PrevMonthStart =
			    EOMONTH ( MaxDate, -2 ) + 1
			VAR PrevMonthEnd =
			    EOMONTH ( MaxDate, -1 )
			RETURN
			CALCULATE (
			    SUM ( Transactions[net_revenue] ),
			    DATESBETWEEN (
			        Calendar[Date],
			        PrevMonthStart,
			        PrevMonthEnd
			    )
			)
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Time Intelligence
		lineageTag: f60773cb-7931-4724-bd67-730479f4ae90

	measure 'MoM growth %' = DIVIDE([Previous Month Revenue],[MTD Revenue],0)
		formatString: 0%;-0%;0%
		displayFolder: Time Intelligence
		lineageTag: 3a454e6f-0722-4c4b-b48a-33c8b13a0e2a

	measure 'Last 7 Days Revenue' =
			
			CALCULATE(
			    SUM(Transactions[net_revenue]),
			    DATESINPERIOD(
			        Calendar[Date],
			        LASTDATE(Calendar[Date]),
			        -7,
			        DAY
			    )
			)
		formatString: "Rs"#,0.###############;-"Rs"#,0.###############;"Rs"#,0.###############
		displayFolder: Time Intelligence
		lineageTag: 4ef14e58-8009-4905-b566-d145b9790ce0

		annotation PBI_FormatHint = {"currencyCulture":"en-PK"}

	measure 'Weekend Revenue' = ```
			
			CALCULATE(
			    [Total Revenue],
			    Calendar[Is Weekend] = "Yes"
			)
			
			```
		formatString: "Rs"#,0.###############;-"Rs"#,0.###############;"Rs"#,0.###############
		displayFolder: Time Intelligence
		lineageTag: af391b33-7012-4971-a73d-165c5b6a109c

		annotation PBI_FormatHint = {"currencyCulture":"en-PK"}

	measure 'Previous Week Revenue' = ```
			
			VAR MaxDate =
			    MAX ( Calendar[Date] )
			VAR PrevWeekStart =
			    MaxDate - WEEKDAY ( MaxDate, 2 ) - 6
			VAR PrevWeekEnd =
			    PrevWeekStart + 6
			RETURN
			CALCULATE (
			    [Total Revenue],
			    DATESBETWEEN (
			        Calendar[Date],
			        PrevWeekStart,
			        PrevWeekEnd
			    )
			)
			
			```
		formatString: "Rs"#,0.###############;-"Rs"#,0.###############;"Rs"#,0.###############
		displayFolder: Time Intelligence
		lineageTag: 5b7d23ae-aebc-4e3a-b72f-9fb1218df84a

		annotation PBI_FormatHint = {"currencyCulture":"en-PK"}

	measure 'Current Week Revenue' = ```
			
			VAR MaxDate =
			    MAX ( Calendar[Date] )
			VAR WeekStart =
			    MaxDate - WEEKDAY ( MaxDate, 2 ) + 1
			VAR WeekEnd =
			    WeekStart + 6
			RETURN
			CALCULATE (
			    [Total Revenue],
			    DATESBETWEEN (
			        Calendar[Date],
			        WeekStart,
			        WeekEnd
			    )
			)
			
			```
		formatString: "Rs"#,0.###############;-"Rs"#,0.###############;"Rs"#,0.###############
		displayFolder: Time Intelligence
		lineageTag: d29bd30c-a235-42f0-a2a6-660186781c63

		annotation PBI_FormatHint = {"currencyCulture":"en-PK"}

	measure 'WoW % Change' = ```
			
			VAR CurrentWeekRevenue =
			    [Current Week Revenue]
			VAR PreviousWeekRevenue =
			    [Previous Week Revenue]
			RETURN
			DIVIDE (
			    CurrentWeekRevenue - PreviousWeekRevenue,
			    PreviousWeekRevenue
			)
			
			```
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: Time Intelligence
		lineageTag: 7ad87273-4618-4242-a8e1-88d92a3b066d

