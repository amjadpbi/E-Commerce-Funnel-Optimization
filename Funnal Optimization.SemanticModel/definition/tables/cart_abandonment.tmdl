	column 'Time Bucket Grouped' =
			
			SWITCH(
			    TRUE(),
			    'Cart_Abandonment'[time_in_cart_mins] <= 10, "0-10 min (Immediate)",
			    'Cart_Abandonment'[time_in_cart_mins] <= 20, "11-20 min (Quick)",
			    'Cart_Abandonment'[time_in_cart_mins] <= 30, "21-30 min (Extended)",
			    "31-45 min (Long)"
			)
		lineageTag: 2514146a-e0bb-481a-8baf-23ffa6831d90
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

